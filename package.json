{
  "name": "hermes-dash",
  "version": "1.0.2",
  "private": true,
  "description": "dash (\\) — persistent web companion interface for Hermes Agent (Dashboard plugin frontend)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint frontend scripts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "package": "bash scripts/package.sh",
    "check": "npm run version:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
